# Gemini API Configuration
# Get your API key from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-3.5-flash-lite

# Vintern-Embedding-1B (local dense text retriever; token vectors mean-pooled to one vector per chunk)
VINTERN_MODEL=5CD-AI/Vintern-Embedding-1B
VINTERN_DEVICE=auto

# GraphRAG (off by default): extracts (subject, predicate, object) triples
# from chunks via Gemini at indexing time, building a small in-memory graph
# for relationship-style queries ("how is X connected to Y"). This adds a
# real Gemini API cost at upload time (batched, GRAPH_EXTRACT_BATCH_SIZE
# chunks per call) - a cost this project otherwise only pays per question.
ENABLE_GRAPH_RAG=false
GRAPH_EXTRACT_BATCH_SIZE=8
GRAPH_HOPS=1
TOP_K_GRAPH=5
RRF_WEIGHT_GRAPH=0.2

# Retrieval & Fusion Parameters
TOP_K_SPARSE=5
TOP_K_DENSE=5
TOP_N_RERANK=3
# LangChain EnsembleRetriever RRF weights (must sum to ~1.0)
RRF_WEIGHT_SPARSE=0.5
RRF_WEIGHT_DENSE=0.5

# Reranker (local, no API call - Vietnamese-specific, ~100M params)
RERANKER_MODEL=itdainb/PhoRanker
RERANKER_DEVICE=auto
RERANKER_MAX_LENGTH=256

# Chunking
CHUNK_SIZE=400
CHUNK_OVERLAP=60

# TruLens RAG Triad Evaluation
ENABLE_TRIAD_EVAL=true

# Web app
CORS_ORIGINS=http://localhost:5173
